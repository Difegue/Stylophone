<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- For Mac App Store builds only, which must be sandboxed: pass -p:CodesignEntitlements=Entitlements.MacAppStore.plist when publishing them.
     Other builds (including the Developer ID one) use Entitlements.plist. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- MPD servers, their httpd stream for local playback, and crash reports -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
